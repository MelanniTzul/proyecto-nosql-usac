# Copiar a .env y reemplazar estos valores antes de iniciar Docker.
MONGO_ROOT_USERNAME=usac_admin
MONGO_ROOT_PASSWORD=cambiar_clave_mongo_local
NEO4J_PASSWORD=cambiar_clave_neo4j_local

# FastAPI lee el mismo .env. Los valores siguientes son opcionales.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_AUTH_SOURCE=admin
NEO4J_HOST=127.0.0.1
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
DB_TIMEOUT_SECONDS=3
