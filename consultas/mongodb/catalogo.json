    "explicacion": "countDocuments cuenta documentos; no personas globales ni evaluaciones deduplicadas.",
    "operacion": "countDocuments",
    "filtro": {}
  },
  {
    "id": 3,
    "titulo": "Resumen general de aprobación y advertencias",
    "objetivo": "Calcular total, aprobados, no aprobados, tasa y filas advertidas.",
    "explicacion": "Reutiliza el agregado existente y su tratamiento de denominador cero. La tasa cuenta registros, no personas.",
    "operacion": "existing",
    "funcion": "statistics",
    "argumentos": {}
  },
  {
    "id": 4,
    "titulo": "Volumen anual de evaluaciones",
    "objetivo": "Comparar cuántos registros contiene cada cohorte.",
    "explicacion": "Agrupa por año de ingreso; no utiliza el año de asignación como sustituto.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$group": {
          "_id": "$anio_ingreso",
          "registros": {
            "$sum": 1
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "anio": "$_id",
          "registros": 1
        }
      },
      {
        "$sort": {
          "anio": 1
        }
      }
    ]
  },
  {
    "id": 5,
    "titulo": "Aprobación por año y materia",
    "objetivo": "Comparar la tasa de cada materia dentro de cada cohorte.",
    "explicacion": "Reutiliza approval con el rango completo. MATEMATICA ITUGS permanece separada.",
    "operacion": "existing",
    "funcion": "approval",
    "argumentos": {
