    "objetivo": "Consultar diez registros de Matemática no aprobados de 2024.",
    "explicacion": "Reutiliza find, proyección, orden y cursor de la API. Diez filas no representan el total de la selección.",
    "operacion": "existing",
    "funcion": "evaluations",
    "argumentos": {
      "anio": 2024,
      "materia": "MATEMATICA",
      "aprobado": false,
      "limite": 10
    }
  },
  {
    "id": 2,
    "titulo": "Conteo total documental",
