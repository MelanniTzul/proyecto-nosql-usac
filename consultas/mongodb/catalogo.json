  {
    "id": 19,
    "titulo": "Distribución de años de nacimiento conocidos",
    "objetivo": "Contar registros por año de nacimiento informado.",
    "explicacion": "Excluye nulos; el valor 1900 se conserva como dato publicado y no se convierte automáticamente a ausencia.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$match": {
          "aspirante.anio_nacimiento": {
            "$ne": null
          }
        }
      },
      {
        "$group": {
          "_id": "$aspirante.anio_nacimiento",
          "registros": {
            "$sum": 1
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "anio_nacimiento": "$_id",
          "registros": 1
        }
      },
      {
        "$sort": {
          "anio_nacimiento": 1
        }
      }
    ]
  },
  {
    "id": 20,
    "titulo": "Edad aproximada por año y materia",
    "objetivo": "Describir edad aproximada a la asignación cuando nacimiento está informado.",
    "explicacion": "Resta año de asignación menos nacimiento: no es edad exacta. Para este resumen se restringe a 12–80 años; se informa cuántos registros se incluyen.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$match": {
          "aspirante.anio_nacimiento": {
            "$ne": null
          }
        }
      },
      {
        "$project": {
          "anio": "$anio_ingreso",
          "materia": 1,
          "edad_aproximada": {
            "$subtract": [
              {
                "$toInt": {
                  "$substrBytes": [
                    "$fecha_asignacion",
                    0,
                    4
                  ]
                }
              },
              "$aspirante.anio_nacimiento"
            ]
          }
        }
      },
      {
        "$match": {
          "edad_aproximada": {
            "$gte": 12,
            "$lte": 80
          }
        }
      },
      {
        "$group": {
          "_id": {
            "anio": "$anio",
            "materia": "$materia"
          },
          "registros_incluidos": {
            "$sum": 1
          },
          "edad_minima": {
            "$min": "$edad_aproximada"
          },
          "edad_maxima": {
            "$max": "$edad_aproximada"
          },
          "edad_media": {
            "$avg": "$edad_aproximada"
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "anio": "$_id.anio",
          "materia": "$_id.materia",
          "registros_incluidos": 1,
          "edad_minima": 1,
          "edad_maxima": 1,
          "edad_media": {
            "$round": [
              "$edad_media",
              2
            ]
          }
        }
      },
      {
        "$sort": {
          "anio": 1,
          "materia": 1
        }
      }
    ]
  },
  {
    "id": 21,
    "titulo": "Completitud de datos por cohorte",
    "objetivo": "Cuantificar ausencias por campo dentro de cada año.",
    "explicacion": "Cuenta nulos normalizados sin reemplazarlos. Las ausencias por campo pueden coexistir en la misma fila.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$group": {
          "_id": "$anio_ingreso",
          "registros": {
            "$sum": 1
          },
          "nacimiento_ausente": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$aspirante.anio_nacimiento",
                    null
                  ]
                },
                1,
                0
              ]
            }
          },
          "sexo_ausente": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$aspirante.sexo",
                    null
                  ]
                },
                1,
                0
              ]
            }
          },
          "carrera_ausente": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$carrera.valor",
                    null
                  ]
                },
                1,
                0
              ]
            }
          },
          "departamento_ausente": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$procedencia_educativa.departamento",
                    null
                  ]
                },
                1,
                0
              ]
            }
          },
          "municipio_ausente": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$procedencia_educativa.municipio",
                    null
                  ]
                },
                1,
                0
              ]
            }
          },
          "tipo_ausente": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$procedencia_educativa.tipo",
                    null
                  ]
                },
                1,
                0
              ]
            }
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "anio": "$_id",
          "registros": 1,
          "nacimiento_ausente": 1,
          "sexo_ausente": 1,
          "carrera_ausente": 1,
          "departamento_ausente": 1,
          "municipio_ausente": 1,
          "tipo_ausente": 1,
          "porcentaje_sin_nacimiento": {
            "$round": [
              {
                "$multiply": [
                  {
                    "$divide": [
                      "$nacimiento_ausente",
                      "$registros"
                    ]
                  },
                  100
                ]
              },
              2
            ]
          }
        }
      },
      {
        "$sort": {
          "anio": 1
        }
      }
    ]
  },
  {
    "id": 22,
    "titulo": "Frecuencia de advertencias de calidad",
    "objetivo": "Identificar cuáles advertencias afectan más registros.",
    "explicacion": "Descompone la lista con $unwind. Una fila con varias advertencias contribuye a varias categorías, no a personas distintas.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$unwind": "$calidad.advertencias"
      },
      {
        "$group": {
          "_id": "$calidad.advertencias",
          "registros": {
            "$sum": 1
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "advertencia": "$_id",
          "registros": 1
        }
      },
      {
        "$sort": {
          "registros": -1,
          "advertencia": 1
        }
      }
    ]
  },
  {
    "id": 23,
    "titulo": "Carreras recortadas por cohorte y texto original",
    "objetivo": "Medir la pérdida de precisión conservando el texto original.",
    "explicacion": "Muestra original y normalizado, incluidos espacios de origen. No asigna equivalencias de carrera.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$match": {
          "carrera.estado_normalizacion": "recortada"
        }
      },
      {
        "$group": {
          "_id": {
            "anio": "$anio_ingreso",
            "original": "$originales.carrera_objetivo",
            "normalizado": "$carrera.valor"
          },
          "registros": {
            "$sum": 1
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "anio": "$_id.anio",
          "original": "$_id.original",
          "normalizado": "$_id.normalizado",
          "registros": 1
        }
      },
      {
        "$sort": {
          "anio": 1,
          "original": 1
        }
      }
    ]
  },
  {
    "id": 24,
    "titulo": "Repeticiones exactas de la fuente",
    "objetivo": "Contar grupos de filas originales idénticas y ocurrencias adicionales dentro de cada archivo.",
    "explicacion": "Agrupa las doce columnas originales junto con la huella de archivo. No elimina duplicados ni equipara una repetición a un examen duplicado demostrado.",
    "operacion": "aggregate",
    "allowDiskUse": true,
    "pipeline": [
      {
        "$group": {
          "_id": {
            "archivo_sha256": "$fuente.sha256_archivo",
            "originales": "$originales"
          },
          "ocurrencias": {
            "$sum": 1
          }
        }
      },
      {
        "$match": {
          "ocurrencias": {
            "$gt": 1
          }
        }
      },
      {
        "$group": {
          "_id": null,
          "grupos_repetidos": {
            "$sum": 1
          },
          "ocurrencias_adicionales": {
            "$sum": {
              "$subtract": [
                "$ocurrencias",
                1
              ]
            }
          },
          "maxima_multiplicidad": {
            "$max": "$ocurrencias"
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "grupos_repetidos": 1,
          "ocurrencias_adicionales": 1,
          "maxima_multiplicidad": 1
        }
      }
    ]
  },
  {
    "id": 25,
    "titulo": "Aspirantes de cohorte y carga de registros",
    "objetivo": "Contar identificadores año-correlativo por cohorte y sus registros asociados.",
    "explicacion": "No suma identidades de años distintos como si fueran personas globales. Promedio calculado por aspirante de cohorte.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$group": {
          "_id": {
            "anio": "$anio_ingreso",
            "cohorte": "$aspirante.cohorte_id"
          },
          "registros": {
            "$sum": 1
          }
        }
      },
      {
        "$group": {
          "_id": "$_id.anio",
          "aspirantes_cohorte": {
            "$sum": 1
          },
          "registros": {
            "$sum": "$registros"
          },
          "minimo_registros": {
            "$min": "$registros"
          },
          "maximo_registros": {
            "$max": "$registros"
          },
          "promedio_registros": {
            "$avg": "$registros"
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "anio": "$_id",
          "aspirantes_cohorte": 1,
          "registros": 1,
          "minimo_registros": 1,
          "maximo_registros": 1,
          "promedio_registros": {
            "$round": [
              "$promedio_registros",
              2
            ]
          }
        }
      },
      {
        "$sort": {
          "anio": 1
        }
      }
    ]
  },
  {
    "id": 26,
    "titulo": "Histograma de registros por aspirante de cohorte",
    "objetivo": "Determinar cuántas cohortes individuales tienen uno, dos o más registros.",
    "explicacion": "La cantidad es de registros publicados, no intentos inferidos; incluye repeticiones originales.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$group": {
          "_id": "$aspirante.cohorte_id",
          "registros": {
            "$sum": 1
          }
        }
      },
      {
        "$group": {
          "_id": "$registros",
          "aspirantes_cohorte": {
            "$sum": 1
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "registros_por_aspirante": "$_id",
          "aspirantes_cohorte": 1
        }
      },
      {
        "$sort": {
          "registros_por_aspirante": 1
        }
      }
    ]
  },
  {
    "id": 27,
    "titulo": "Aprobación en ambas materias dentro de la cohorte",
    "objetivo": "Consultar hasta cien aspirantes de 2024 con ambas materias aprobadas.",
    "explicacion": "Reutiliza both_subjects, devuelve truncado si hay más. La lista acotada no es un total ni demuestra admisión definitiva.",
    "operacion": "existing",
    "funcion": "both_subjects",
    "argumentos": {
      "anio": 2024,
      "limite": 100
    }
  },
  {
    "id": 28,
    "titulo": "Múltiples carreras informadas dentro del año",
    "objetivo": "Contar aspirantes de cohorte con más de una categoría de carrera observada.",
    "explicacion": "El conjunto usa valor y estado, excluye carrera ausente y no sigue a personas entre años. No infiere el orden de cambios.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$match": {
          "carrera.valor": {
            "$ne": null
          }
        }
      },
      {
        "$group": {
          "_id": {
            "anio": "$anio_ingreso",
            "cohorte": "$aspirante.cohorte_id"
          },
          "carreras": {
            "$addToSet": {
              "valor": "$carrera.valor",
              "estado": "$carrera.estado_normalizacion"
            }
          }
        }
      },
      {
        "$project": {
          "anio": "$_id.anio",
          "cantidad_carreras": {
            "$size": "$carreras"
          }
        }
      },
      {
        "$match": {
          "cantidad_carreras": {
            "$gt": 1
          }
        }
      },
      {
        "$group": {
          "_id": "$anio",
          "aspirantes_con_multiples_carreras": {
            "$sum": 1
          },
          "maximo_categorias_observadas": {
            "$max": "$cantidad_carreras"
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "anio": "$_id",
          "aspirantes_con_multiples_carreras": 1,
          "maximo_categorias_observadas": 1
        }
      },
      {
        "$sort": {
          "anio": 1
        }
      }
    ]
  },
  {
    "id": 29,
    "titulo": "Coexistencia de resultados por cohorte y materia",
    "objetivo": "Contar aspirantes con registros aprobados y no aprobados de la misma materia dentro del año.",
    "explicacion": "No presupone mejoría, secuencia de intentos ni fecha real de examen. Solo constata coexistencia de resultados publicados.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$group": {
          "_id": {
            "anio": "$anio_ingreso",
            "cohorte": "$aspirante.cohorte_id",
            "materia": "$materia"
          },
          "resultados": {
            "$addToSet": "$aprobado"
          }
        }
      },
      {
        "$match": {
          "resultados": {
            "$all": [
              true,
              false
            ]
          }
        }
      },
      {
        "$group": {
          "_id": {
            "anio": "$_id.anio",
            "materia": "$_id.materia"
          },
          "aspirantes_con_ambos_resultados": {
            "$sum": 1
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "anio": "$_id.anio",
          "materia": "$_id.materia",
          "aspirantes_con_ambos_resultados": 1
        }
      },
      {
        "$sort": {
          "anio": 1,
          "materia": 1
        }
      }
    ]
  },
  {
    "id": 30,
    "titulo": "Catálogos reales con estado de carrera",
    "objetivo": "Consultar los dominios observados para filtros y análisis.",
    "explicacion": "Reutiliza catalogs: $facet para años, materias y tipos, más careers compartida para categorías de carrera. No se considera otra consulta nueva por cada opción del catálogo.",
    "operacion": "existing",
    "funcion": "catalogs",
    "argumentos": {}
  }
]
