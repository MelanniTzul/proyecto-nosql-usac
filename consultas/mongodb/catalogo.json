      "hasta": 2024
    }
  },
  {
    "id": 6,
    "titulo": "Resultados por sexo informado",
    "objetivo": "Mostrar distribución y aprobación por sexo, incluyendo ausencias.",
    "explicacion": "Los valores nulos son una categoría explícita; no se imputa sexo.",
    "operacion": "aggregate",
    "pipeline": [
      {
        "$group": {
          "_id": {
            "sexo": "$aspirante.sexo"
          },
          "registros": {
            "$sum": 1
          },
          "aprobados": {
            "$sum": {
              "$cond": [
                "$aprobado",
                1,
                0
              ]
            }
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "sexo": "$_id.sexo",
          "registros": 1,
          "aprobados": 1,
          "no_aprobados": {
            "$subtract": [
              "$registros",
              "$aprobados"
            ]
          },
          "porcentaje_aprobacion": {
            "$round": [
              {
                "$multiply": [
                  {
                    "$divide": [
                      "$aprobados",
                      "$registros"
                    ]
                  },
                  100
                ]
              },
              2
            ]
          }
        }
      },
      {
        "$sort": {
          "sexo": 1
        }
      }
    ]
  },
